---
import "../styles/style.css";

const title = "B2B Solutions & ROI | Big Brain Way";
const description =
    "Find the operational leaks costing your business time, speed and money — then turn them into measurable ROI with automation and intelligent systems.";
---

<!doctype html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta
        name="description"
        content={description}
    />

    <meta
        name="theme-color"
        content="#050b18"
    />

    <title>{title}</title>

</head>


<body>


<!-- =====================================================
     SCROLL PROGRESS
===================================================== -->

<div
    class="scroll-progress"
    aria-hidden="true"
></div>



<!-- =====================================================
     MINIMAL LANDING PAGE HEADER
===================================================== -->

<header class="navbar">

    <a
        href="#home"
        class="brand"
        aria-label="Big Brain Way"
    >

        <img
            src="/image/BBW Logo.png"
            alt="Big Brain Way"
        />

    </a>

    <div class="nav-status">

        <span class="status-dot"></span>

        B2B SOLUTIONS & ROI

    </div>

</header>



<!-- =====================================================
     HERO
     LINKEDIN LEAK FUNNEL
===================================================== -->

<section
    class="hero"
    id="home"
>

    <div
        class="hero-grid"
        aria-hidden="true"
    ></div>

    <div
        class="orb orb-one"
        aria-hidden="true"
    ></div>

    <div
        class="orb orb-two"
        aria-hidden="true"
    ></div>

    <div
        class="orb orb-three"
        aria-hidden="true"
    ></div>


    <div class="hero-container">


        <!-- =================================================
             HERO CONTENT
        ================================================== -->

        <div class="hero-content">

            <p class="eyebrow">

                <span class="eyebrow-dot pulse-dot"></span>

                LINKEDIN / LEAK AUDIT

            </p>


            <h1>

                You Found The

                <br />

                <span>
                    Operational Leak.
                </span>

                <strong>
                    Now Let's Measure It.
                </strong>

            </h1>


            <p class="hero-description">

                Every growing B2B business has friction hiding
                inside its workflows — manual work, slow lead
                response, disconnected systems and underused
                software.

                <br /><br />

                We find the leak, quantify the cost and identify
                where automation can create measurable ROI.

            </p>


            <!-- PRIMARY CTA -->

            <div class="cta-group">

                <a
                    href="#consultation"
                    class="primary-button"
                >

                    <span>
                        BOOK A FREE CONSULTATION
                    </span>

                    <b>
                        →
                    </b>

                </a>


                <a
                    href="#leak-audit"
                    class="secondary-button"
                >

                    <span>
                        FIND THE LEAK
                    </span>

                    <b>
                        ↓
                    </b>

                </a>

            </div>


            <!-- HERO PROOF -->

            <div class="hero-proof">


                <div class="stat-item">

                    <strong>
                        20 mins
                    </strong>

                    <span>
                        manual quote generation
                    </span>

                    <div class="stat-bar"></div>

                </div>


                <div class="stat-item">

                    <strong>
                        5 sec
                    </strong>

                    <span>
                        automated lead response
                    </span>

                    <div class="stat-bar"></div>

                </div>


                <div class="stat-item">

                    <strong>
                        30 min
                    </strong>

                    <span>
                        free ROI consultation
                    </span>

                    <div class="stat-bar"></div>

                </div>

            </div>

        </div>



        <!-- =================================================
             HERO LIVE ROI VISUAL
        ================================================== -->

        <div class="hero-visual">

            <div
                class="visual-glow"
                aria-hidden="true"
            ></div>


            <div class="consulting-preview">


                <div class="preview-header">

                    <span>
                        LIVE OPERATIONAL AUDIT
                    </span>

                    <span class="live-status">

                        <i></i>

                        ANALYZING

                    </span>

                </div>



                <!-- LIVE LEAK METER -->

                <div
                    class="roi-dashboard animate-on-scroll"
                    id="leak-audit"
                >

                    <div class="dashboard-metrics">


                        <div class="metric metric-1">

                            <span class="metric-label">
                                TIME LEAK
                            </span>

                            <strong>
                                20 min
                            </strong>

                            <div class="metric-bar">

                                <div
                                    class="metric-fill"
                                    style="width: 75%"
                                ></div>

                            </div>

                            <span class="metric-source">
                                Manual quote workflow
                            </span>

                        </div>



                        <div class="metric metric-2">

                            <span class="metric-label">
                                SPEED LEAK
                            </span>

                            <strong>
                                2 days
                            </strong>

                            <div class="metric-bar">

                                <div
                                    class="metric-fill"
                                    style="width: 88%"
                                ></div>

                            </div>

                            <span class="metric-source">
                                Manual lead follow-up
                            </span>

                        </div>



                        <div class="metric metric-3">

                            <span class="metric-label">
                                SYSTEM LEAK
                            </span>

                            <strong>
                                6+ tools
                            </strong>

                            <div class="metric-bar">

                                <div
                                    class="metric-fill"
                                    style="width: 68%"
                                ></div>

                            </div>

                            <span class="metric-source">
                                Disconnected workflows
                            </span>

                        </div>


                    </div>


                    <div class="dashboard-note">

                        ⚡ Find the leak before buying another tool.

                        <span>
                            Your actual ROI depends on your workflow,
                            volume and systems.
                        </span>

                    </div>

                </div>



                <!-- TRANSFORMATION PREVIEW -->

                <div class="client-results animate-on-scroll">

                    <div class="results-header">

                        <span>
                            OPERATIONAL TRANSFORMATION
                        </span>

                    </div>


                    <div class="results-grid">


                        <div class="result-item result-1">

                            <div class="result-icon">
                                ⏱
                            </div>

                            <div>

                                <strong>
                                    Manual → Automated
                                </strong>

                                <p>
                                    Remove repetitive workflow steps
                                </p>

                            </div>

                            <div class="result-glow"></div>

                        </div>



                        <div class="result-item result-2">

                            <div class="result-icon">
                                ⚡
                            </div>

                            <div>

                                <strong>
                                    Slow → Instant
                                </strong>

                                <p>
                                    Respond while opportunities are warm
                                </p>

                            </div>

                            <div class="result-glow"></div>

                        </div>



                        <div class="result-item result-3">

                            <div class="result-icon">
                                🔗
                            </div>

                            <div>

                                <strong>
                                    Fragmented → Connected
                                </strong>

                                <p>
                                    Integrate the systems you already use
                                </p>

                            </div>

                            <div class="result-glow"></div>

                        </div>


                    </div>


                    <div class="results-note">

                        <span>
                            The objective is measurable operational improvement.
                        </span>

                        <span class="results-cta-secondary">

                            <a href="#roi">
                                See the ROI model →
                            </a>

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     LEAK INTRODUCTION
===================================================== -->

<section class="problem-section">

    <div class="section-container">


        <div class="problem-heading">

            <p class="eyebrow">
                <span class="eyebrow-dot"></span>
                THE OPERATIONAL LEAK
            </p>


            <h2>

                Your Business May Not
                <span>
                    Need More Software.
                </span>

                <br />

                It May Need Better Systems.

            </h2>


            <p>

                Growth creates complexity.

                More leads create more follow-up.
                More orders create more administration.
                More software creates more disconnected data.

                The result is operational friction that
                quietly compounds every week.

            </p>


            <div class="story-outcome">

                <span>
                    🎯 OBJECTIVE:
                </span>

                <span>
                    Identify where time, speed and systems are leaking.
                </span>

            </div>

        </div>



        <div class="problem-data">


            <!-- TIME TRAP -->

            <div
                class="data-card card-one animate-on-scroll"
                data-leak="time"
            >

                <span class="data-label">
                    01 / TIME TRAP
                </span>


                <strong>
                    20 mins per quote
                </strong>


                <p class="data-description">

                    Repetitive quote generation turns
                    valuable employee time into administration.

                </p>


                <div class="comparison-visual">

                    <span class="manual">
                        Manual: 20 min
                    </span>

                    <span class="vs">
                        →
                    </span>

                    <span class="automated">
                        Automated: seconds
                    </span>

                </div>


                <div class="data-source">
                    LinkedIn campaign example
                </div>

            </div>



            <!-- SPEED GAP -->

            <div
                class="data-card card-two animate-on-scroll"
                data-leak="speed"
            >

                <span class="data-label">
                    02 / SPEED GAP
                </span>


                <strong>
                    5 sec vs 2 days
                </strong>


                <p class="data-description">

                    The longer a warm lead waits,
                    the greater the opportunity cost.

                </p>


                <div class="speed-visual">

                    <div class="speed-bar auto">

                        <span>
                            AUTOMATED
                        </span>

                    </div>


                    <div class="speed-bar manual">

                        <span>
                            MANUAL
                        </span>

                    </div>

                </div>


                <div class="data-source">
                    LinkedIn campaign example
                </div>

            </div>



            <!-- SOFTWARE MESS -->

            <div
                class="data-card card-three animate-on-scroll"
                data-leak="systems"
            >

                <span class="data-label">
                    03 / SOFTWARE MESS
                </span>


                <strong>
                    Disconnected systems
                </strong>


                <p class="data-description">

                    Multiple SaaS tools can create
                    duplicate work when they cannot communicate.

                </p>


                <div class="software-visual">

                    <div class="software-bar">

                        <span class="used">
                            CONNECTED
                        </span>

                        <span class="unused">
                            FRICTION
                        </span>

                    </div>

                </div>


                <div class="data-source">
                    LinkedIn campaign example
                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     INTERACTIVE TRANSFORMATION
===================================================== -->

<section class="solution-section" id="automation">

    <div class="section-container">


        <div class="center-heading">

            <p class="eyebrow">

                <span class="eyebrow-dot"></span>

                FROM LEAK TO SYSTEM

            </p>


            <h2>

                Find It.

                <br />

                <span>
                    Fix It. Measure It.
                </span>

            </h2>


            <p>

                We don't start with another software subscription.

                We start with the workflow.

                Then we determine what should be integrated,
                automated and measured.

            </p>


            <div class="story-outcome">

                <span>
                    🎯 OBJECTIVE:
                </span>

                <span>
                    Turn operational friction into a measurable system.
                </span>

            </div>

        </div>



        <!-- TRANSFORMATION FLOW -->

        <div class="solution-grid">


            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="1"
            >

                <div class="solution-icon">
                    🔍
                </div>


                <span class="data-label">
                    STEP 01
                </span>


                <h3>
                    Identify
                </h3>


                <p>

                    Map the workflow and locate
                    repetitive tasks, bottlenecks
                    and unnecessary handoffs.

                </p>


                <div class="card-shine"></div>

            </div>



            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="2"
            >

                <div class="solution-icon">
                    🔗
                </div>


                <span class="data-label">
                    STEP 02
                </span>


                <h3>
                    Integrate
                </h3>


                <p>

                    Connect the tools you already use
                    so information can move without
                    constant manual intervention.

                </p>


                <div class="card-shine"></div>

            </div>



            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="3"
            >

                <div class="solution-icon">
                    ⚡
                </div>


                <span class="data-label">
                    STEP 03
                </span>


                <h3>
                    Automate
                </h3>


                <p>

                    Replace repetitive steps with
                    intelligent workflows that execute
                    consistently.

                </p>


                <div class="card-shine"></div>

            </div>



            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="4"
            >

                <div class="solution-icon">
                    📊
                </div>


                <span class="data-label">
                    STEP 04
                </span>


                <h3>
                    Measure
                </h3>


                <p>

                    Track time saved, response speed,
                    operational cost and business impact.

                </p>


                <div class="card-shine"></div>

            </div>



            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="5"
            >

                <div class="solution-icon">
                    📈
                </div>


                <span class="data-label">
                    STEP 05
                </span>


                <h3>
                    Scale
                </h3>


                <p>

                    Build systems that support growth
                    without simply adding more manual work.

                </p>


                <div class="card-shine"></div>

            </div>



            <div
                class="solution-card card-3d animate-on-scroll"
                data-stage="6"
            >

                <div class="solution-icon">
                    🧠
                </div>


                <span class="data-label">
                    OUTCOME
                </span>


                <h3>
                    Intelligent Operations
                </h3>


                <p>

                    A clearer operating system for the
                    business — built around measurable outcomes.

                </p>


                <div class="card-shine"></div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     ROI SECTION
===================================================== -->

<section
    class="results-section"
    id="roi"
>

    <div class="section-container">


        <div class="results-heading">

            <p class="eyebrow">

                <span class="eyebrow-dot"></span>

                ROI / PROOF

            </p>


            <h2>

                Don't Just

                <br />

                <span>
                    Automate.
                </span>

                Measure.

            </h2>


            <p>

                The value of automation is not the automation itself.

                The value is the time recovered,
                response improved, cost reduced and
                capacity created.

            </p>


            <div class="story-outcome">

                <span>
                    🎯 OBJECTIVE:
                </span>

                <span>
                    Connect operational improvement to business value.
                </span>

            </div>

        </div>



        <!-- ROI MODEL -->

        <div class="results-grid-full">


            <div
                class="result-card card-1 animate-on-scroll"
            >

                <div class="result-badge">
                    TIME
                </div>


                <div class="result-metric">

                    <span class="metric-number">
                        20m
                    </span>

                    <span class="metric-label">
                        Example manual task
                    </span>

                </div>


                <h3>
                    Quote Generation
                </h3>


                <p>

                    A repetitive quoting workflow can
                    consume employee time that could instead
                    be spent on customers, sales or delivery.

                </p>


                <div class="result-details">

                    <span>
                        Manual workflow
                    </span>

                    <span>
                        → Automation opportunity
                    </span>

                </div>


                <div class="result-glow"></div>

            </div>



            <div
                class="result-card card-2 animate-on-scroll"
            >

                <div class="result-badge">
                    SPEED
                </div>


                <div class="result-metric">

                    <span class="metric-number">
                        &lt;5s
                    </span>

                    <span class="metric-label">
                        Example automated response
                    </span>

                </div>


                <h3>
                    Lead Response
                </h3>


                <p>

                    Automated lead-response workflows can
                    reduce the delay between inquiry and
                    first response.

                </p>


                <div class="result-details">

                    <span>
                        Faster response
                    </span>

                    <span>
                        → More opportunity
                    </span>

                </div>


                <div class="result-glow"></div>

            </div>



            <div
                class="result-card card-3 animate-on-scroll"
            >

                <div class="result-badge">
                    SYSTEMS
                </div>


                <div class="result-metric">

                    <span class="metric-number">
                        6+
                    </span>

                    <span class="metric-label">
                        Example connected tools
                    </span>

                </div>


                <h3>
                    System Integration
                </h3>


                <p>

                    Connecting CRM, forms, communication,
                    operations and reporting can eliminate
                    repeated data entry between systems.

                </p>


                <div class="result-details">

                    <span>
                        API integration
                    </span>

                    <span>
                        → Connected workflow
                    </span>

                </div>


                <div class="result-glow"></div>

            </div>



            <div
                class="result-card card-4 animate-on-scroll"
            >

                <div class="result-badge">
                    ROI
                </div>


                <div class="result-metric">

                    <span class="metric-number">
                        ROI
                    </span>

                    <span class="metric-label">
                        Personalized assessment
                    </span>

                </div>


                <h3>
                    Your Numbers
                </h3>


                <p>

                    Every business is different.

                    We use your workflow, volume,
                    labor cost and operational constraints
                    to identify potential value.

                </p>


                <div class="result-details">

                    <span>
                        Your data
                    </span>

                    <span>
                        → Your assessment
                    </span>

                </div>


                <div class="result-glow"></div>

            </div>

        </div>



        <!-- ROI CTA -->

        <div class="results-cta-wrapper">

            <div class="results-cta-group">

                <a
                    href="#consultation"
                    class="primary-button"
                >

                    <span>
                        GET MY ROI ASSESSMENT
                    </span>

                    <b>
                        →
                    </b>

                </a>

            </div>


            <span class="results-cta-note">

                No obligation. No generic software pitch.
                Just a conversation about your workflow.

            </span>

        </div>

    </div>

</section>



